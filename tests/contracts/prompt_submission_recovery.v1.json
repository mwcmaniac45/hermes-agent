        "canonical_b": {
          "attachments": [],
          "display_kind": "normal",
          "display_metadata": null,
          "interrupted": false,
          "queued": false,
          "replay_controls": null,
          "surface": "main",
          "text_sha256": "b94d27b9934d3e08a52e52d7da7dabfac484efe04294e576af58cb95b6887f",
          "truncation_consent": false,
          "truncation_target": null
        },
        "expect_same_fingerprint": true
      },
      {
        "id": "ceq_attachment_list_order_normalized",
        "description": "Attachments with same (order, identity, version) tuples but different array positions must produce the same fingerprint after sort normalization.",
        "canonical_a": {
          "text_sha256": "b94d27b9934d3e08a52e52d7da7dabfac484efe04294e576af58cb95b6887f",
          "display_kind": "normal",
          "display_metadata": null,
          "queued": false,
          "interrupted": false,
          "surface": "main",
          "truncation_target": null,
          "truncation_consent": false,
          "attachments": [
            {"order": 1, "identity": "img-a", "version": "1"},
            {"order": 2, "identity": "img-b", "version": "1"}
          ],
          "replay_controls": null
        },
        "canonical_b": {
          "text_sha256": "b94d27b9934d3e08a52e52d7da7dabfac484efe04294e576af58cb95b6887f",
          "display_kind": "normal",
          "display_metadata": null,
          "queued": false,
          "interrupted": false,
          "surface": "main",
          "truncation_target": null,
          "truncation_consent": false,
          "attachments": [
            {"order": 2, "identity": "img-b", "version": "1"},
            {"order": 1, "identity": "img-a", "version": "1"}
          ],
          "replay_controls": null
        },
        "expect_same_fingerprint": true,
        "note": "Implementations must sort attachments by (order, identity, version) before fingerprinting."
      }
    ],
